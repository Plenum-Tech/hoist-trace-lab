# Copy to .env and fill in. Never commit .env. Every value here reaches the container as an environment variable.

# ── Databases ───────────────────────────────────────────────────────────────────────────────────────
# Hoistra's database: the SAME database Hoistra uses. Trace Lab only reads it (its connection is read-only), to show
# every question people asked Hoistra and how each answer was made. postgresql+asyncpg://, ?sslmode=require on Azure.
DB_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/HOISTRA_DATABASE?sslmode=require

# Where Trace Lab keeps its own records (labels, who has access, golden sets). It needs write access and CREATE
# (its migrations create one schema, tracelab). Recommended: a database hoist_tracelab on the SAME Postgres server as
# Hoistra (README.md, "The database", explains why not inside Hoistra's own database).
TRACE_LAB_DB_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/hoist_tracelab?sslmode=require

# ── Hoistra ─────────────────────────────────────────────────────────────────────────────────────────
# Hoistra's address, scheme and host only (https://hoistra.example.com), no path. Set it when Trace Lab has its own
# address: the page signs in with Hoistra's accounts through /backend/ops-intelligence/, which this container then
# passes to Hoistra. Leave it EMPTY when Hoistra's gateway already serves /lab/ and /backend/trace-lab/.
HOISTRA_URL=

# Hoistra's services, as Trace Lab's service reaches them (inside Azure, or through Hoistra's address). Who is signed
# in is checked by Hoistra's operations-intelligence (GET /api/auth/me), so TRACE_LAB_UPSTREAM_OI is REQUIRED.
# The other three are only used by golden runs (asking the chat a question again).
# Through Hoistra's address:  https://hoistra.example.com/backend/ops-intelligence
# Inside one Docker network:  http://svc-operations-intelligence:8009
TRACE_LAB_UPSTREAM_OI=
TRACE_LAB_UPSTREAM_UDR=
TRACE_LAB_UPSTREAM_WOM=
TRACE_LAB_UPSTREAM_DOCRAG=

# ── Models ──────────────────────────────────────────────────────────────────────────────────────────
# Labelling needs neither key. The judges and the grader use Anthropic; golden runs ask the chat model (OpenAI).
# Use the same values as Hoistra's svc-deepagents.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
ORCHESTRATOR_LLM_ROUTING=0
COMPLIANCE_SKILL_PATH=0
COMPLIANCE_SELECTIVE_SKILLS=0

# ── Optional ────────────────────────────────────────────────────────────────────────────────────────
# The host port for docker compose (the container listens on 8080).
TRACE_LAB_PORT=8080
# Run only the service (port 8010) without the page and nginx, for a gateway that does both itself.
# TRACE_LAB_NGINX=0
# Spending limits (USD). Defaults: a golden run 25, golden runs 50 a month, proposal runs 100 a month, a judge run 5,
# a monitoring batch 5, eval-case grading 2.
# TRACE_LAB_GOLDEN_RUN_MAX_USD=
# TRACE_LAB_GOLDEN_MONTHLY_USD=
# TRACE_LAB_PROPOSALS_MONTHLY_USD=
# TRACE_LAB_JUDGE_RUN_USD_CAP=
# TRACE_LAB_MONITOR_USD_CAP=
# TRACE_LAB_EVAL_GRADING_USD_CAP=
